# Copy to .env.preview.local and fill in. .env.preview.local is gitignored.
#
# Loaded ONLY by `npm run build:preview` (Vite mode "preview") and by the dev
# server when copied to .env.local. A normal `npm run build` / `build:site`
# does NOT pick this up, so the password never reaches the tracked site/ folder.
#
# Note: in a preview build this value ends up readable in the JS bundle.
# It is obfuscation for a static site, not a security control.
VITE_PREVIEW_PASSWORD=
